{
  "name": "generative-rhythm-desktop",
  "productName": "Generative Rhythm",
  "version": "0.1.0",
  "private": true,
  "description": "Generative Rhythm Game desktop app: Electron window + bundled analysis server",
  "main": "main.js",
  "author": "Generative Rhythm Game",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "dev.generative-rhythm.app",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "windowState.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist/rhythm-server",
        "to": "server"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Generative Rhythm",
      "artifactName": "GenerativeRhythm-Setup-${version}.${ext}",
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "multiLanguageInstaller": true
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png"
    },
    "publish": null
  }
}
